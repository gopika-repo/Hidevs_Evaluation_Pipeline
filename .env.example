# ============================================================
# Dave Evaluation Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.

# Google AI / Gemini model for evaluation judges
# Confirm exact model string with team before deployment.
GEMINI_MODEL_NAME=gemini-3.5-flash
GOOGLE_API_KEY=your-api-key-here

# Concurrency limits and logging
EVALUATION_MAX_CONCURRENCY=5
ENABLE_RAW_LLM_LOGS=false

# Timeouts in seconds
GEMINI_TIMEOUT=30.0
TRULENS_TIMEOUT=45.0
DEEPEVAL_TIMEOUT=45.0

# Batch run mode (full or quick)
PIPELINE_MODE=quick

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
