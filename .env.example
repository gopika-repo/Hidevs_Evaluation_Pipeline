# ============================================================
# Dave Evaluation Pipeline — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.

# Google AI / Gemini API Credentials
GOOGLE_API_KEY=your-api-key-here
GEMINI_MODEL_NAME=gemini-3.5-flash

# Concurrency limits and logging
EVALUATION_MAX_CONCURRENCY=5
LOG_LEVEL=INFO

# Timeouts in seconds
GEMINI_TIMEOUT=30.0
TRULENS_TIMEOUT=45.0
DEEPEVAL_TIMEOUT=45.0

# Allowed Frontend Origins (comma-separated for CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
